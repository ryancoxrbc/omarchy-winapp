if group "setup and uninstall"; then (
  failed=0
  mkdir -p "$HOME/.local/bin"
  echo "an older script" >"$HOME/.local/bin/winapp"
  omarchy=$XDG_DATA_HOME/applications/windows-vm.desktop
  mkdir -p "${omarchy%/*}"
  printf '[Desktop Entry]\nName=Windows\nExec=uwsm app -- omarchy-windows-vm launch\nIcon=/icons/windows.png\n' >"$omarchy"
  out=$("$WINAPP" setup --yes --no-scan 2>&1)
  is "setup succeeds" "$?" "0"
  is "the command is linked onto PATH" "$(realpath "$HOME/.local/bin/winapp")" "$WINAPP"
  is "a file that was in the way is kept" "$(cat "$XDG_DATA_HOME"/winapp/backup/winapp.*)" "an older script"
  [[ -s $XDG_CONFIG_HOME/winapp/config.json && -s $XDG_CONFIG_HOME/winapp/apps.json ]] && pass || fail "setup writes the default settings"
  lacks "nothing is asked of polkit when Docker is reachable" "$out" "password"
  succeeds "setup can be run again" "$WINAPP" setup --yes --no-scan
  entry=$(cat "$XDG_DATA_HOME/applications/winapp-desktop.desktop" 2>/dev/null)
  has "Windows in the app launcher is winapp's" "$entry" $'Name=Windows\nComment'
  has "…opening its window" "$entry" "Exec=$HOME/.local/bin/winapp desktop"
  has "…with Omarchy's icon" "$entry" "Icon=/icons/windows.png"
  has "Omarchy's own entry stays, renamed" "$(cat "$omarchy")" "Name=Omarchy Windows"
  has "…and otherwise untouched" "$(cat "$omarchy")" "Exec=uwsm app -- omarchy-windows-vm launch"

  "$WINAPP" add demo --exe 'C:\\demo.exe' --ext qzx9 --icon "$ROOT/tests/fixtures/icon.png" >/dev/null 2>&1
  has "menu entries call the linked command" "$(cat "$XDG_DATA_HOME/applications/winapp-demo.desktop")" "Exec=$HOME/.local/bin/winapp demo %F"

  succeeds "uninstall" "$WINAPP" uninstall --yes
  [[ ! -e $HOME/.local/bin/winapp ]] && pass || fail "uninstall removes the link"
  [[ -z $(ls "$XDG_DATA_HOME/applications"/winapp-* 2>/dev/null) ]] && pass || fail "uninstall removes the menu entries"
  [[ ! -e $XDG_DATA_HOME/mime/packages/winapp-qzx9.xml ]] && pass || fail "uninstall removes the private file types"
  has "uninstall gives Omarchy's entry its name back" "$(cat "$omarchy")" $'Name=Windows\n'

  [[ -s $XDG_CONFIG_HOME/winapp/apps.json ]] && pass || fail "uninstall keeps the app list"
  [[ -d $XDG_DATA_HOME/winapp/backup ]] && pass || fail "uninstall keeps the file setup moved aside"
  ln -s "$WINAPP" "$HOME/.local/bin/winapp"
  succeeds "uninstall --purge" "$WINAPP" uninstall --yes --purge
  [[ ! -e $XDG_CONFIG_HOME/winapp ]] && pass || fail "--purge removes the settings too"

  rm -f "$WINAPP_VM_HELPER"
  refuses "setup needs Omarchy's Windows VM support" "$WINAPP" setup --yes --no-scan
  exit $failed
); failed=$((failed + $?)); fi

# -------------------------------------------------------------------------------
if group "resources: the VM's memory and processors"; then (
  failed=0
  cat >"$WINAPP_VM_DIR/docker-compose.yml" <<'COMPOSE'
services:
  windows:
    environment:
      RAM_SIZE: "4G"
      CPU_CORES: "2"
      DISK_SIZE: "64G"
      USERNAME: "docker"
      PASSWORD: "x"
      TZ: "Europe/Paris"
COMPOSE
  has "the current values are read from Omarchy's configuration" "$("$WINAPP" resources)" "4 GB of memory, 2 processors"
  is "state carries them for the panel" "$("$WINAPP" state | jq -r '.ram + " " + .cores')" "4G 2"
  has "setting what is already set changes nothing" "$("$WINAPP" resources --ram 4 --cores 2)" "nothing to change"
  [[ ! -e $STUB_OUT/pkexec.calls ]] && pass || fail "…and asks for no password"

  succeeds "changing the memory alone" "$WINAPP" resources --ram 2gb
  is "Omarchy's writer gets the full set, the rest exactly as it was" "$(cat "$STUB_OUT/compose.written")" \
    $'RAM=2G\nCORES=2\nDISK=64G\nUSERNAME=tester\nPASSWORD=p=ss w"rd\nTZ=Europe/Paris'
  has "…through Omarchy's own helper" "$(cat "$STUB_OUT/pkexec.calls")" "$WINAPP_VM_HELPER __priv write_compose"
  succeeds "changing the processors alone" "$WINAPP" resources --cores 1
  has "…keeps the memory" "$(cat "$STUB_OUT/compose.written")" $'RAM=4G\nCORES=1\n'

  refuses "more memory than the computer has" "$WINAPP" resources --ram 999
  refuses "less than Windows needs" "$WINAPP" resources --ram 1
  refuses "no processors" "$WINAPP" resources --cores 0
  refuses "more processors than the computer has" "$WINAPP" resources --cores 99
  refuses "nonsense" "$WINAPP" resources --ram plenty

  mkdir -p "$XDG_RUNTIME_DIR/winapp/clients" && : >"$STUB_OUT/window-open"
  "$WINAPP" run 'C:\\x.exe' >/dev/null 2>&1 &
  app=$!
  for _ in $(seq 100); do [[ -s $STUB_OUT/launch.rdp ]] && break; sleep 0.1; done
  rm -f "$STUB_OUT/compose.written"
  refuses "nothing changes while an app is open" "$WINAPP" resources --ram 2
  [[ ! -e $STUB_OUT/compose.written ]] && pass || fail "…and nothing is written"
  rm -f "$STUB_OUT/window-open"
  wait "$app"
  "$WINAPP" stop >/dev/null 2>&1

  # Without Docker access the compose file cannot be read: the disk size comes
  # from the image, the time zone from the system, the rest from what is known.
  load
  COMPOSE=$TMP/world/unreadable.yml
  refuses "no disk image, no guess at its size" vm_disk
  truncate -s 64G "$STORAGE_DIR/data.img"
  is "the disk size is the size of the image" "$(vm_disk)" "64G"
  rm -f "$STUB_OUT/compose.written"
  (resources_write 8G 4) >/dev/null 2>&1
  is "the full set is still complete" "$(cat "$STUB_OUT/compose.written")" \
    $'RAM=8G\nCORES=4\nDISK=64G\nUSERNAME=tester\nPASSWORD=p=ss w"rd\nTZ=Africa/Nairobi'
  is "…and what was set is remembered" "$(vm_resources)" "8G 4"
  (
    qemu_args() { echo "123 qemu-system-x86_64 -nodefaults -cpu host -smp 6,sockets=1,cores=6 -m 12G -machine q35 -name windows,process=windows"; }
    is "a running VM shows what it was really given" "$(vm_resources)" "12G 6"
  )
  truncate -s 68719476737 "$STORAGE_DIR/data.img"
  refuses "an image that is not a whole number of GB is not guessed at" vm_disk
  rm -f "$STUB_OUT/compose.written" "$CREDENTIALS"
  truncate -s 64G "$STORAGE_DIR/data.img"
  refuses "without the VM's account nothing is written" resources_write 8G 4
  [[ ! -e $STUB_OUT/compose.written ]] && pass || fail "…really nothing"

  is "sizes are read generously" "$(normal_ram 8; normal_ram 16g; normal_ram '32 GB'; normal_ram 4GiB)" $'8G\n16G\n32G\n4G'
  exit $failed
); failed=$((failed + $?)); fi

# -------------------------------------------------------------------------------
if group "shim: the Super key and the pointer"; then (
  failed=0
  if ! command -v cc >/dev/null || [[ ! -e /usr/include/X11/Xlib.h ]]; then
    echo "  skipped: needs a C compiler and the X11 headers"
    exit 0
  fi
  build=$TMP/world/shim
  mkdir -p "$build"
  succeeds "the shim compiles without warnings" cc -shared -fPIC -O2 -Wall -Wextra -Werror -o "$build/xshim.so" "$ROOT/shim/xshim.c" -ldl
  succeeds "the test harness compiles" bash -c "cc -shared -fPIC -o '$build/libfakex.so' '$HERE/shim/fakex.c' && cc -o '$build/test' '$HERE/shim/test.c' -L'$build' -lfakex -Wl,-rpath,'$build'"
  out=$(LD_PRELOAD=$build/xshim.so "$build/test")
  is "Super stays with the desktop; ordinary typing goes through" "$?:$out" "0:"
  if "$build/test" >/dev/null; then fail "the harness notices when the shim is not loaded"; else pass; fi
  out=$(WINAPP_SUPER=windows WINAPP_POINTER=200 LD_PRELOAD=$build/xshim.so "$build/test" settings)
  is "Super goes to Windows when asked, and the pointer is reduced on a scaled monitor" "$?:$out" "0:"
  exit $failed
); failed=$((failed + $?)); fi

# -------------------------------------------------------------------------------
if group "repository: catalog, manifest and scripts"; then (
  failed=0
  load
  succeeds "catalog.json is valid JSON" jq -e . "$ROOT/catalog.json"
  is "catalog ids are unique" "$(jq -r '.apps | map(.id) | group_by(.) | map(select(length > 1) | .[0]) | join(" ")' "$ROOT/catalog.json")" ""
  is "catalog ids are usable as app ids" "$(jq -r --arg c "$COMMANDS" '.apps[] | select((.id | test("^[a-z0-9][a-z0-9_.+-]*$") | not) or (.id | test("^(" + $c + ")$"))) | .id' "$ROOT/catalog.json")" ""
  is "catalog executables are lower case" "$(jq -r '.apps[].exe[] | select(. != ascii_downcase)' "$ROOT/catalog.json")" ""
  is "catalog extensions are bare and lower case" "$(jq -r '.apps[] | ((.ext // []) + (.opens // []))[] | select(test("^[a-z0-9_+-]+$") | not)' "$ROOT/catalog.json")" ""
  is "every catalog app has a name and a program" "$(jq -r '.apps[] | select((.name // "") == "" or ((.exe // []) | length) == 0) | .id' "$ROOT/catalog.json")" ""

  id=$(jq -r .id "$ROOT/manifest.json")
  has "the panel registers under the manifest's id" "$(cat "$ROOT/Panel.qml")" "moduleName: \"$id\""
  has "…for IPC too" "$(cat "$ROOT/Panel.qml")" "ipcTarget: \"$id\""
  [[ -f $ROOT/$(jq -r .entryPoints.barWidget "$ROOT/manifest.json") ]] && pass || fail "the manifest's entry point exists"
  has "the changelog covers the manifest's version" "$(cat "$ROOT/CHANGELOG.md" 2>/dev/null)" "## $(jq -r .version "$ROOT/manifest.json")"
  is "no symlinks (Omarchy refuses plugins that have any)" "$(find "$ROOT" -name .git -prune -o -type l -print)" ""
  [[ -x $ROOT/setup && -x $WINAPP ]] && pass || fail "setup and bin/winapp are executable"
  has "help lists every command group" "$("$WINAPP" help)" "winapp manage"
  is "version comes from the manifest" "$("$WINAPP" version)" "$(jq -r .version "$ROOT/manifest.json")"
  exit $failed
); failed=$((failed + $?)); fi

echo
if ((failed)); then
  echo "$failed check(s) failed"
  exit 1
fi
echo "all checks passed"
