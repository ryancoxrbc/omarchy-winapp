#!/bin/bash
# Stand-in for the FreeRDP client: records what it was asked to do, says it
# signed in, and stays up until it is killed, like the real one.
out=${STUB_OUT:?}
mapfile -t args

# A job for inside the VM (lib/guest.sh) comes with a folder to answer in.
# Answer as Windows would: with $STUB_OUT/guest.json when a test put one
# there, and otherwise with everything having gone well.
job=""
for arg in "${args[@]}"; do
  [[ $arg == /drive:winapp,* ]] && job=${arg#/drive:winapp,}
done
if [[ -n $job ]]; then
  printf '%s\n' "${args[@]}" >"$out/guest.args"
  [[ -e $job/in.json ]] && cp -- "$job/in.json" "$out/guest.in.json"
  echo run >>"$out/guest.runs"
  if [[ -e $out/guest.json ]]; then
    cp -- "$out/guest.json" "$job/out.json"
  else
    printf '{"frame":{"status":"ok"},"echo":"%s"}\n' "$(cat "$job/probe.txt")" >"$job/out.json"
  fi
  echo "[INFO] Logon Extended Info [cookie: TRUE, LogonId: 4, errorInfo: FALSE]"
  : >"$job/done"
else
  printf '%s\n' "$*" >"$out/client.argv"
  printf '%s\n' "${LD_PRELOAD:-}" >"$out/client.preload"
  printf '%s\n' "${WINAPP_SUPER:-}" >"$out/client.super"
  printf '%s\n' "${args[@]}" >"$out/client.args"
  [[ ${args[0]:-} == *.rdp ]] && cp -- "${args[0]}" "$out/launch.rdp"
  echo $$ >"$out/client.pid"
  echo "[INFO] Logon Extended Info [cookie: TRUE, LogonId: 4, errorInfo: FALSE]"
  [[ -e $out/client.fail ]] && { cat "$out/client.fail"; exit 1; }
fi
# not exec: the process has to keep this script's name, which is how winapp
# tells its own clients from anything else
sleep 600 &
trap 'kill $! 2>/dev/null; exit 143' TERM
wait $!
