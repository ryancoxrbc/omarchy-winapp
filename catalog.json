      "registry": [
        { "key": "HKCU\\Software\\Microsoft\\Office\\16.0\\Common\\General", "name": "PreferCloudSaveLocations", "type": "REG_DWORD", "value": "0" },
        { "key": "HKCU\\Software\\Microsoft\\Office\\16.0\\PowerPoint\\RecentFolderList", "name": "Default", "type": "REG_EXPAND_SZ", "value": "{documents}" }
      ]
    },
