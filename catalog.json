{
  "version": 1,
  "apps": [
    {
      "id": "word",
      "name": "Microsoft Word",
      "label": "Word",
      "categories": "Office;WordProcessor;",
      "exe": ["winword.exe"],
      "ext": ["docx", "doc", "docm", "dotx", "dotm"],
      "opens": ["rtf", "odt"],
      "startScreen": { "title": "Word", "args": "/w" },
      "registry": [
        { "key": "HKCU\\Software\\Microsoft\\Office\\16.0\\Common\\General", "name": "PreferCloudSaveLocations", "type": "REG_DWORD", "value": "0" },
        { "key": "HKCU\\Software\\Microsoft\\Office\\16.0\\Word\\Options", "name": "DOC-PATH", "type": "REG_EXPAND_SZ", "value": "{documents}" }
      ]
    },
    {
      "id": "excel",
      "name": "Microsoft Excel",
      "label": "Excel",
      "categories": "Office;Spreadsheet;",
      "exe": ["excel.exe"],
      "ext": ["xlsx", "xls", "xlsm", "xlsb", "xltx", "xltm"],
      "opens": ["csv", "ods"],
      "startScreen": { "title": "Excel", "args": "/x" },
      "registry": [
        { "key": "HKCU\\Software\\Microsoft\\Office\\16.0\\Common\\General", "name": "PreferCloudSaveLocations", "type": "REG_DWORD", "value": "0" },
        { "key": "HKCU\\Software\\Microsoft\\Office\\16.0\\Excel\\Options", "name": "DefaultPath", "type": "REG_EXPAND_SZ", "value": "{documents}" }
      ]
    },
    {
      "id": "powerpoint",
      "name": "Microsoft PowerPoint",
